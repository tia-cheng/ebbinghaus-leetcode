{
  "name": "ebbinghaus-leetcode",
  "displayName": "LeetCode 间隔重复",
  "version": "0.1.0",
  "description": "基于艾宾浩斯记忆曲线的 LeetCode 刷题复习提醒扩展：自动捕获 Accepted 提交，按 1/3/7/15/30 天间隔安排复习。",
  "author": "tiacheng29@gmail.com",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@headlessui/react": "^2.1.2",
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.11.0",
    "plasmo": "^0.89.4",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.263",
    "@types/node": "^26.4.1",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier": "3.2.5",
    "tailwindcss": "^3.4.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://leetcode.com/*",
      "https://leetcode.cn/*"
    ],
    "permissions": [
      "storage"
    ]
  }
}
